programa {
  funcao inicio() {
     //entedimento do problema
    //infos e variaveis
    inteiro salarioMensal
    inteiro diasTrabalhados
    inteiro total 
    inteiro salarioDiario
    //entrada de dados
    escreva ("quanto é seu salario mensal? ")
    leia (salarioMensal)
    escreva ("você trabalhou quantos dias? ")
    leia (diasTrabalhados)
    //processamento
    total = salarioMensal / diasTrabalhados
    salarioDiario = total 
    //saida
    escreva ("seu salario semanal é de: ")
    escreva (salarioDiario)
  }
}
