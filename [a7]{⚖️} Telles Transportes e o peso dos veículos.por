programa {
  funcao inicio() {
    //entedimento do problema
    //infos e variaveis
    inteiro pesoDoCaminhao
    inteiro taraDoCaminhao
    inteiro total
    inteiro resultado
    //entrada de dados
    escreva ("qual é o peso do caminhão? ")
    leia (pesoDoCaminhao)
    escreva ("qual é a tara do caminhão? ")
    leia (taraDoCaminhao)
    //processamento
    total = pesoDoCaminhao - taraDoCaminhao
    resultado = total 
    //saida
    escreva ("a carga total do caminhão é de: ")
    escreva (total)
  }
}
